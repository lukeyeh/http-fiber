# Ignore all bazel-* symlinks. There is no full list since this can change
# based on the name of the directory bazel is cloned into.
/bazel-*

# Generated by `bazel run :compile_commands`.
/compile_commands.json
/external

# clangd index.
/.cache/

# direnv.
/.direnv/

# Profiling output: recordings from perf, pictures from flamegraph, and
# profiles saved by samply.
/flamegraph.svg
/perf.data*
/profile.json*
