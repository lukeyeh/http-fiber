module(name = "http_fiber")

bazel_dep(name = "rules_cc", version = "0.2.25")

# Gloop, from the fork that builds under Nix. It only exists as a Bazel
# module, so unlike other libraries it cannot come from nixpkgs. Depend on its
# targets as "@gloop//gloop/util/gtl:intrusive_list".
#
# To update, take a newer commit of the fork's `nix` branch (each sync is also
# tagged nix-YYYYMMDD), and run `nix flake update gloop`.
bazel_dep(name = "gloop")
git_override(
    module_name = "gloop",
    commit = "e7b1c2f777cd832dbd7d3844f74eb3b70dcef544",
    remote = "https://github.com/lukeyeh/gloop.git",
)

# Libraries Gloop itself is built against come from the Bazel registry too,
# at the versions in Gloop's MODULE.bazel, so that a binary holds one copy.
# Depend on them as "@abseil-cpp//absl/strings" and "@googletest//:gtest".
bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")

# Every other third-party library comes from nixpkgs. nix/deps.nix says which
# libraries; flake.lock pins their versions.
bazel_dep(name = "rules_nixpkgs_core", version = "0.14.0")

# The nixpkgs that flake.lock pins, as <nixpkgs> for the files below.
nix_repo = use_extension("@rules_nixpkgs_core//extensions:repository.bzl", "nix_repo")
nix_repo.flake(
    name = "nixpkgs",
    lock_file = "//:flake.lock",
)
use_repo(nix_repo, "nixpkgs")

# One external repository per library, each holding a single cc_library named
# after it. Depend on them as "@gbenchmark".
#
# The BUILD files below load rules_cc by its canonical name, "@@rules_cc+",
# because they are evaluated inside repositories that rules_nixpkgs creates,
# where the short name "@rules_cc" is not known.
#
# Shared libraries are listed by the file name the dynamic linker will look
# for (libfoo.so.1), not the bare libfoo.so, so that Bazel sets the binary up
# to find them at run time.
nix_pkg = use_extension("@rules_nixpkgs_core//extensions:package.bzl", "nix_pkg")
nix_pkg.file(
    name = "gbenchmark",
    attr = "gbenchmark",
    build_file_content = """\
load("@@rules_cc+//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "gbenchmark",
    testonly = True,
    srcs = ["lib/libbenchmark.a"],
    hdrs = glob(["include/**"]),
    includes = ["include"],
    linkopts = ["-pthread"],
    visibility = ["//visibility:public"],
)
""",
    file = "//nix:bazel.nix",
    file_deps = ["//nix:deps.nix"],
    repo = "@nixpkgs",
)
use_repo(nix_pkg, "gbenchmark")

# Generates compile_commands.json for clangd: `bazel run :compile_commands`
# https://github.com/wolfd/bazel-compile-commands
bazel_dep(name = "wolfd_bazel_compile_commands", version = "0.5.2", dev_dependency = True)
